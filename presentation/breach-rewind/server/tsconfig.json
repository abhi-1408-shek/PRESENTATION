  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "./dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": true
  },
  "include": ["src"]
}
