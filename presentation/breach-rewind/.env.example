# Server port for the Socket.IO/Express backend
PORT=3001

# Public URL for QR code generation
# IMPORTANT: Change this to your actual LAN IP or deployed URL
# for audience members to join from their phones.
#
# Examples:
#   Local network:  http://192.168.1.42:5173
#   Deployed:       https://breach-rewind.example.com
#   Development:    http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
