# Configuration for Neuromorphic Security Estimator
# Copy this file to .env and fill in your values

# Port for the Flask application
PORT=5055

# Host to bind to (0.0.0.0 for production, 127.0.0.1 for local)
HOST=0.0.0.0

# Admin token for training and profile reset
# CHANGE THIS TO A SECURE RANDOM STRING FOR PRODUCTION!
ADMIN_TOKEN=your-secret-admin-token-here

# Required in Render: Internal Database URL from your Render PostgreSQL service.
# For local development, omit this and the app uses instance/estimator.db.
# DATABASE_URL=postgresql://...

# A long random secret used to hash the enrolled IP before it is stored.
IP_HMAC_KEY=replace-with-a-long-random-secret

# Render sits behind one reverse proxy. Do not increase unless your hosting
# configuration explicitly adds another trusted proxy.
TRUSTED_PROXY_HOPS=1

# Optional: Public base URL if behind a proxy
# PUBLIC_BASE_URL=https://your-domain.com
