# Configuration for Neuromorphic Security Estimator
# Copy this file to .env and fill in your values

# Port for the Flask application
PORT=5055

# Host to bind to (0.0.0.0 for production, 127.0.0.1 for local)
HOST=0.0.0.0

# Admin token for training and override authentication
# CHANGE THIS TO A SECURE RANDOM STRING FOR PRODUCTION!
ADMIN_TOKEN=your-secret-admin-token-here

# Optional: Public base URL if behind a proxy
# PUBLIC_BASE_URL=https://your-domain.com
